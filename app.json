{
  "expo": {
    "name": "TAXIS ONE Chauffeur",
    "slug": "taxis-one-chauffeur",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "taxionechauffeur",
    "android": {
      "package": "dz.taxione.chauffeur",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "dz.taxione.chauffeur",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TAXIS ONE utilise votre position pendant votre service afin que la centrale puisse suivre votre véhicule."
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#8B5CF6",
          "defaultChannel": "courses"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autoriser TAXIS ONE à utiliser votre position pendant votre service."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e67c24bc-2abb-49b1-87eb-c2537f583ca2"
      }
    },
    "owner": "taxi-one"
  }
}
